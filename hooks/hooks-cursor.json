{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" session-start"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" pre-tool-guard"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" secrets-scan",
        "matcher": "commit"
      },
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" git-push-checkpoint",
        "matcher": "push"
      }
    ],
    "postToolUse": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" token-meter",
        "matcher": ".*"
      },
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" metrics-collector",
        "matcher": "Skill|Task"
      }
    ],
    "preCompact": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" pre-compact"
      }
    ],
    "sessionEnd": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" post-session-reflect"
      }
    ],
    "stop": [
      {
        "command": "node -e \"require(require('path').resolve(process.env.CURSOR_PLUGIN_ROOT||'.','hooks','run-hook.cjs'))\" post-session-reflect"
      }
    ]
  }
}
